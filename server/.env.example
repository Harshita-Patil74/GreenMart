PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/greenmart
JWT_SECRET=change_me_long_random
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Production (set on Render): CLIENT_URL=https://green-mart-three.vercel.app
# Multiple origins (comma-separated): CLIENT_URL=https://green-mart-three.vercel.app,http://localhost:5173
DELIVERY_CHARGE=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=app-password
EMAIL_FROM="GreenMart <your@gmail.com>"
ADMIN_EMAIL=your-admin@gmail.com
ADMIN_PASSWORD=
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest

SEED_PASSWORD=
EMAIL_ENABLED=false

RESEND_API_KEY=

NEWSLETTER_FROM_EMAIL=

NEWSLETTER_FROM_NAME=GreenMart

NEWSLETTER_REPLY_TO=

NEWSLETTER_UNSUBSCRIBE_SECRET=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NEWSLETTER_EMAIL_MODE=mock


IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
